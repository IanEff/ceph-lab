# ceph-lab — cluster topology defaults
#
# Committed to git — do NOT put secrets here.
# Secrets (GITOPS_REPO_URL, GITOPS_REPO_TOKEN, GITOPS_SSH_KEY_PATH) go in .env (gitignored).
#
# Sourced by:
#   - Lima YAML provision steps (inside VMs)
#   - provisioning/lima-up.sh (on the Mac host)
#   - provisioning/scripts/manage_k8s_config.py

# ─── Cluster topology ─────────────────────────────────────────────────────────

SANDBOX_NUM_CEPH_NODES=3
SANDBOX_OSD_DISKS_PER_NODE=2

# ─── Networking ───────────────────────────────────────────────────────────────

SANDBOX_CONTROL_PLANE_IP=192.168.56.50
SANDBOX_CEPH_NODE_IP_BASE=60          # ceph-node-1 → .61, ceph-node-2 → .62, ceph-node-3 → .63
SANDBOX_GATEWAY_LB_IP=192.168.56.200  # Cilium L2 LB — pinned in dnsmasq
SANDBOX_DNS_DOMAIN=ceph.lab           # *.ceph.lab resolves to the gateway IP

# ─── Kubernetes ───────────────────────────────────────────────────────────────

SANDBOX_K3S_CHANNEL=v1.32

# ─── Component versions ───────────────────────────────────────────────────────

CILIUM_VERSION=1.18.2
GATEWAY_API_VERSION=v1.4.1
ARGOCD_VERSION=stable

# ─── Optional features ────────────────────────────────────────────────────────

# Set to 1 to auto-bootstrap ArgoCD + root app during 'make up'.
# Requires GITOPS_REPO_URL and token/key to be set in .env first.
SANDBOX_INSTALL_ARGOCD=1

# Set to 1 to write a dnsmasq entry so *.ceph.lab resolves on macOS.
# Requires: brew install dnsmasq  →  sudo brew services start dnsmasq
SANDBOX_CONFIGURE_DNSMASQ=1
