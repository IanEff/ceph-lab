# ceph-lab — cluster topology defaults
#
# Committed to git — do NOT put secrets here.
# Secrets (GITOPS_REPO_URL, GITOPS_REPO_TOKEN, GITOPS_SSH_KEY_PATH) go in .env (gitignored).
#
# Sourced by:
#   - Lima YAML provision steps (inside VMs)
#   - provisioning/lima-up.sh (on the Mac host)
#   - provisioning/scripts/manage_k8s_config.py

# ─── Cluster topology ─────────────────────────────────────────────────────────

SANDBOX_NUM_CEPH_NODES=3
SANDBOX_OSD_DISKS_PER_NODE=2

# ─── Networking ───────────────────────────────────────────────────────────────

SANDBOX_CONTROL_PLANE_IP=192.168.56.50
SANDBOX_CEPH_NODE_IP_BASE=60          # ceph-node-1 → .61, ceph-node-2 → .62, ceph-node-3 → .63
SANDBOX_GATEWAY_LB_IP=192.168.56.200  # Cilium L2 LB — pinned in dnsmasq
SANDBOX_DNS_DOMAIN=ceph.lab           # *.ceph.lab resolves to the gateway IP

# ─── Kubernetes ───────────────────────────────────────────────────────────────

SANDBOX_K3S_CHANNEL=v1.33

# ─── Component versions ───────────────────────────────────────────────────────

CILIUM_VERSION=1.19.3
GATEWAY_API_VERSION=v1.5.1
# Pinned to what the `stable` tag resolves to as of 2026-08-22 — was a floating
# tag before, which meant every fresh bootstrap could silently pick up a new
# ArgoCD release mid-development. Bump deliberately, not by drifting back to
# `stable`.
ARGOCD_VERSION=v3.5.1

# ─── Local pull-through cache ─────────────────────────────────────────────────
# On by default: common.sh probes the cache via a 1s TCP check and falls
# through silently to the public registries on a miss, so this is safe even
# if `just cache-up` was never run or docker isn't installed — the only cost
# of a miss is that one probe's timeout. Host is the ceph-lab socket_vmnet
# gateway IP (the Mac itself); ports match provisioning/cache/docker-compose.yaml.
SANDBOX_CACHE_ENABLED=1
SANDBOX_CACHE_HOST=192.168.56.1
SANDBOX_CACHE_APT_PORT=3142
SANDBOX_CACHE_REGISTRY_DOCKERHUB_PORT=5001
SANDBOX_CACHE_REGISTRY_K8S_PORT=5002
SANDBOX_CACHE_REGISTRY_GHCR_PORT=5003
SANDBOX_CACHE_REGISTRY_QUAY_PORT=5004

# ─── Optional features ────────────────────────────────────────────────────────

# Set to 1 to auto-bootstrap ArgoCD + root app during 'make up'.
# Requires GITOPS_REPO_URL and token/key to be set in .env first.
SANDBOX_INSTALL_ARGOCD=1

# Set to 1 to write a dnsmasq entry so *.ceph.lab resolves on macOS.
# Requires: brew install dnsmasq  →  sudo brew services start dnsmasq
SANDBOX_CONFIGURE_DNSMASQ=1
