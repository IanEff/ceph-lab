# NOTE: applications/**/charts/ used to be gitignored here ("built by kustomize
# --enable-helm during local bootstrap") — that's now backwards. Five slow-fetching
# charts (rook-ceph, grafana, loki, promtail, prometheus-operator-crds) are
# deliberately vendored and committed so the repo-server never needs a live network
# round-trip to render them; kustomize reuses a local chart dir instead of
# `helm pull`ing on every sync. See applications/rook/operator/charts/,
# applications/infrastructure/{grafana,loki,promtail,prometheus-operator-crds}/charts/.
# Do not re-add a blanket ignore here — that would silently drop them from git again.

# go-task local cache/checksum dir
.task/

# Local environment — never commit real credentials
.env

# k3s join token (generated by control-plane.sh, written to shared mount)
provisioning/node-token

# macOS junk
.DS_Store
**/.DS_Store

# Python cache
__pycache__/
*.pyc
*.pyo

# Editors
.idea/
*.swp
*.swo
*~

# ISO images (sometimes pulled for testing)
*.iso

# Kubeconfig fragments copied out during manage_k8s_config.py
kubeconfig*.yaml

# Ansible retry files (if ever added)
*.retry

# Generated sealed-secrets private key backups
sealed-secrets-key*.yaml

# Deploy keys
deploy_ceph-lab
deploy_ceph-lab.pub

# Claude Code project config (personal tool settings)
.claude/

# Antigravity CLI project links (local host paths, never commit)
.antigravitycli/