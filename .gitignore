# Helm chart caches (built by kustomize --enable-helm during local bootstrap)
applications/**/charts/

# Local environment — never commit real credentials
.env

# Vagrant state
.vagrant/

# k3s join token (generated by control-plane.sh)
node-token

# macOS junk
.DS_Store
**/.DS_Store

# Python cache
__pycache__/
*.pyc
*.pyo

# Editors
.idea/
*.swp
*.swo
*~

# ISO images (sometimes pulled for testing)
*.iso

# Kubeconfig fragments copied out during manage_k8s_config.py
kubeconfig*.yaml

# Ansible retry files (if ever added)
*.retry

# Generated sealed-secrets private key backups
sealed-secrets-key*.yaml

# Deploy keys
deploy_ceph-lab
deploy_ceph-lab.pub

# Claude Code project config (personal tool settings)
.claude/