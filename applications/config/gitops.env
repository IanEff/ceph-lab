# Cluster-scoped configuration injected into every infrastructure Application
# via the `../../config` Kustomize Component.
#
# Kustomize replacements use these values to patch hostnames, IPs, and CIDR
# references across all infrastructure manifests.

CONTROL_PLANE_IP=192.168.56.50
POD_CIDR=10.244.0.0/16
SERVICE_CIDR=10.96.0.0/12
LB_CIDR=192.168.56.192/27
GATEWAY_IP=192.168.56.200
DOMAIN=ceph.lab
WILDCARD_DOMAIN=*.ceph.lab

# Service hostnames
ARGOCD_HOSTNAME=argocd.ceph.lab
GRAFANA_HOSTNAME=grafana.ceph.lab
HUBBLE_HOSTNAME=hubble.ceph.lab
DASHBOARD_HOSTNAME=dashboard.ceph.lab
PROMETHEUS_HOSTNAME=prometheus.ceph.lab
ALERTMANAGER_HOSTNAME=alertmanager.ceph.lab

# Component versions
KUBERNETES_VERSION=1.32
GATEWAY_API_VERSION=v1.4.1
CILIUM_VERSION=1.18.2
CERT_MANAGER_VERSION=v1.14.5
ROOK_VERSION=v1.19.1
