# ceph-lab — user environment overrides
# Copy to .env and run: direnv allow
#
# Cluster topology defaults are in provisioning/provision.env (committed).
# This file is for secrets and per-user overrides only — never commit .env.

# ─── GitOps (required for ArgoCD bootstrap) ───────────────────────────────────

# Full URL of this repo — used by ArgoCD to reconcile state.
# Use the SSH form when authenticating with the deploy key (recommended):
#   git@github.com:YOUR_USERNAME/ceph-lab.git
# HTTPS form is also supported if you prefer a token instead:
#   https://github.com/YOUR_USERNAME/ceph-lab.git
GITOPS_REPO_URL=git@github.com:YOUR_USERNAME/ceph-lab.git

# GitHub personal access token (for HTTPS access only).
# Leave empty when using the SSH deploy key.
GITOPS_REPO_TOKEN=

# Path to the SSH deploy private key, relative to the repo root.
# The key pair (deploy_ceph-lab / deploy_ceph-lab.pub) lives at ./ and is
# gitignored.  The public key must be registered as a GitHub deploy key.
# install_argocd.sh auto-detects deploy_ceph-lab when this is left unset.
GITOPS_SSH_KEY_PATH=deploy_ceph-lab

# ─── Optional overrides ───────────────────────────────────────────────────────
# These override the defaults in provisioning/provision.env.

# Set to 1 to auto-bootstrap ArgoCD + root app during 'make up'.
# Requires GITOPS_REPO_URL and token/key to be configured first.
# SANDBOX_INSTALL_ARGOCD=0

# OSD disks per worker node. Each appears as /dev/vdc, /dev/vdd, etc.
# Changing this requires make destroy + make up to take effect.
# SANDBOX_OSD_DISKS_PER_NODE=2

# ─── Local pull-through cache (optional, dramatically speeds up boots) ────────
# When enabled, common.sh probes each port via TCP. If reachable, it points
# APT and k3s/containerd at the local cache; if not, it falls through silently
# to the public-mirror fallback (no boot impact).
#
# Expects apt-cacher-ng on :3142 and OCI registry mirrors on :5001-5004 at
# the host-only network gateway (192.168.56.1 = the Mac). The pull-through
# cache itself isn't provisioned by this repo — bring up your own with
# docker / colima / nix etc. on the Mac side.
#
# SANDBOX_CACHE_ENABLED=1
# SANDBOX_CACHE_HOST=192.168.56.1
# SANDBOX_CACHE_APT_PORT=3142
# SANDBOX_CACHE_REGISTRY_DOCKERHUB_PORT=5001
# SANDBOX_CACHE_REGISTRY_K8S_PORT=5002
# SANDBOX_CACHE_REGISTRY_GHCR_PORT=5003
# SANDBOX_CACHE_REGISTRY_QUAY_PORT=5004
