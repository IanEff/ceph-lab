# ceph-lab — environment configuration
# Copy to .env and run: direnv allow
#
# All variables have sane defaults for a local VirtualBox/k3s lab.
# The only ones you MUST set are related to GitOps repo access.

# ─── Cluster topology ─────────────────────────────────────────────────────────

# Number of Ceph worker/OSD nodes (minimum 3 for host-level fault domain)
SANDBOX_NUM_CEPH_NODES=3

# Raw OSD disks per worker node (/dev/sdc, /dev/sdd, …)
SANDBOX_OSD_DISKS_PER_NODE=2

# ─── Networking ───────────────────────────────────────────────────────────────

SANDBOX_CONTROL_PLANE_IP=192.168.56.50
SANDBOX_CEPH_NODE_IP_BASE=60          # ceph-node-1 → .61, ceph-node-2 → .62, …
SANDBOX_GATEWAY_LB_IP=192.168.56.200  # Cilium L2 LB — pinned in dnsmasq
SANDBOX_DNS_DOMAIN=ceph.lab           # *.ceph.lab resolves to the gateway IP

# ─── Kubernetes ───────────────────────────────────────────────────────────────

SANDBOX_KUBERNETES_VERSION_MINOR=1.32
SANDBOX_K3S_CHANNEL=v1.32

# ─── Component versions ───────────────────────────────────────────────────────

ROOK_VERSION=v1.19.1
CILIUM_VERSION=1.18.2
GATEWAY_API_VERSION=v1.4.1
ARGOCD_VERSION=stable               # use "stable" or a tag like "v2.14.0"

# ─── GitOps (required for ArgoCD bootstrap) ───────────────────────────────────

# Full URL of this repo — used by ArgoCD to reconcile state.
# Use the SSH form when authenticating with the deploy key (recommended):
#   git@github.com:YOUR_USERNAME/ceph-lab.git
# HTTPS form is also supported if you prefer a token instead:
#   https://github.com/YOUR_USERNAME/ceph-lab.git
GITOPS_REPO_URL=git@github.com:YOUR_USERNAME/ceph-lab.git

# GitHub personal access token (for HTTPS access only).
# Leave empty when using the SSH deploy key.
GITOPS_REPO_TOKEN=

# Path to the SSH deploy private key, relative to the repo root.
# The key pair (deploy_ceph-lab / deploy_ceph-lab.pub) lives at ./ and is
# gitignored.  The public key must be registered as a GitHub deploy key.
# install_argocd.sh auto-detects deploy_ceph-lab when this is left unset.
GITOPS_SSH_KEY_PATH=deploy_ceph-lab

# ─── Optional features ────────────────────────────────────────────────────────

# Set to 1 to auto-bootstrap ArgoCD + root app after 'vagrant up'.
# Requires GITOPS_REPO_URL and token/key to be configured first.
SANDBOX_INSTALL_ARGOCD=0

# Set to 1 to write a dnsmasq entry so *.ceph.lab resolves on macOS.
# Requires: brew install dnsmasq  →  sudo brew services start dnsmasq
SANDBOX_CONFIGURE_DNSMASQ=1

